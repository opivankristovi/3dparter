# Copy to .env.local and fill in. Everything here is read at build time and is public in the built app.

# Where "Report a problem" sends people: the issues page of the GitHub repository.
# Example: https://github.com/<owner>/<repo>/issues
# Leave empty and the app says the support link is not set up yet; nothing is sent anywhere.
VITE_SUPPORT_URL=

# Where the built site is served. BASE_PATH is the sub-path ('/' at a domain root, '/3dparter/' on GitHub Pages).
# SITE_URL is the full public address with a trailing slash; it makes og:url and og:image absolute, as link previews need.
# When SITE_URL is unset, og:url is left out and og:image is relative to BASE_PATH (previews will not show the card).
# Set both in the build environment (the Pages workflow does), not in a .env file:
# BASE_PATH=/3dparter/
# SITE_URL=https://opivankristovi.github.io/3dparter/
